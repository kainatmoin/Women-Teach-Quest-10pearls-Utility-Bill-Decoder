# =============================================================================
# WTQ Utility Bill Decoder - Environment Variables Template
# Women Tech Quest 2026 (10Pearls)
# =============================================================================
# Instructions:
# 1. Copy this file to .env:
#      copy .env.example .env     (Windows Command Prompt / PowerShell)
#      cp .env.example .env       (Linux / macOS)
# 2. Replace 'your_google_ai_studio_api_key_here' with your actual API key.
# 3. DO NOT commit your .env file to version control.
# =============================================================================

# LLM Provider & Model Selection (Approved competition model: gemini-3.5-flash-lite)
MODEL_PROVIDER=google
MODEL_NAME=gemini-3.5-flash-lite

# Google AI Studio API Key (Obtain from https://aistudio.google.com/app/apikey)
API_KEY=your_google_ai_studio_api_key_here

# Optional: Alternative env var name supported by gemini_client.py
# GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Optional: Web Dashboard Server Configuration (Defaults: HOST=127.0.0.1, PORT=5000)
# Cloud platforms (Render, Railway, etc.) automatically supply PORT
PORT=5000
HOST=127.0.0.1
